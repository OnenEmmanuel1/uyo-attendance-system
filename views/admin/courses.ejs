<%- include('../partials/head', { title: title }) %>
<div class="uuas-app">
  <%- include('../partials/sidebar-admin') %>
  <div class="uuas-main">
    <%- include('../partials/navbar', { topbarTitle: 'Course Management' }) %>
    <div class="uuas-content">
      <div class="uuas-page-header uuas-mb-6">
        <div>
          <h1 class="uuas-h2">Course Directory</h1>
          <p class="uuas-text-sm uuas-muted" style="margin-top:0.25rem">All courses registered in the system. Manage faculty assignment and student rosters.</p>
        </div>
      </div>

      <div class="uuas-card" style="margin-bottom:1.25rem">
        <div class="uuas-card-body">
          <h2 class="uuas-h3">Add Course</h2>
          <p class="uuas-text-xs uuas-muted" style="margin:.25rem 0 1rem">Create a course and assign it to a lecturer.</p>
          <form method="POST" action="/admin/courses/new">
            <div class="uuas-grid-2" style="gap:1rem">
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-code">Course code</label><input class="uuas-input" id="new-course-code" name="code" maxlength="20" required placeholder="CSC301"></div>
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-title">Course title</label><input class="uuas-input" id="new-course-title" name="title" maxlength="200" required placeholder="Data Structures"></div>
            </div>
            <div class="uuas-grid-2" style="gap:1rem">
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-dept">Department</label><select class="uuas-select" id="new-course-dept" name="department" required><option value="">Select department</option><% departments.forEach(d => { %><option value="<%= d.name %>"><%= d.name %></option><% }) %></select></div>
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-lecturer">Lecturer</label><select class="uuas-select" id="new-course-lecturer" name="lecturer_id" required><option value="">Select lecturer</option><% lecturers.forEach(l => { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></div>
            </div>
            <div class="uuas-grid-2" style="gap:1rem">
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-level">Level</label><select class="uuas-select" id="new-course-level" name="level"><option value="">Select level</option><% [100,200,300,400,500].forEach(level => { %><option value="<%= level %>"><%= level %> Level</option><% }) %></select></div>
              <div class="uuas-form-group"><label class="uuas-label" for="new-course-semester">Semester</label><select class="uuas-select" id="new-course-semester" name="semester"><option value="first">First</option><option value="second">Second</option></select></div>
            </div>
            <button class="uuas-btn uuas-btn--primary" type="submit" <%= (!lecturers.length || !departments.length) ? 'disabled' : '' %>>Add Course</button>
            <% if (!lecturers.length) { %><span class="uuas-text-xs uuas-muted"> Add a lecturer account before creating a course.</span><% } %>
          </form>
        </div>
      </div>

      <div class="uuas-card">
        <div class="uuas-table-card-header">
          <div>
            <h2 class="uuas-h3">Courses List</h2>
            <p class="uuas-text-xs uuas-muted" style="margin-top:2px">Lecturer assignments and enrollment metrics</p>
          </div>
          <div class="uuas-table-controls">
            <div class="uuas-table-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" placeholder="Search course..." aria-label="Search courses">
            </div>
          </div>
        </div>

        <div class="uuas-table-wrapper">
          <table class="uuas-table" aria-label="Courses list">
            <thead>
              <tr>
                <th scope="col">Code ↕</th>
                <th scope="col">Title ↕</th>
                <th scope="col">Assigned Lecturer ↕</th>
                <th scope="col">Department ↕</th>
                <th scope="col">Enrolled ↕</th>
                <th scope="col" class="uuas-text-right">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!courses.length) { %>
                <tr><td colspan="6" class="uuas-empty">No courses found.</td></tr>
              <% } %>
              <% courses.forEach(c => { %>
                <tr>
                  <td>
                    <div class="uuas-table-user-cell">
                      <div class="uuas-avatar-circle"><%= c.code.substring(0,2) %></div>
                      <span class="uuas-pill uuas-pill--ontime"><%= c.code %></span>
                    </div>
                  </td>
                  <td><span class="uuas-bold"><%= c.title %></span></td>
                  <td>
                    <div class="uuas-method-cell">
                      <span class="uuas-method-dot uuas-method-dot--qr"></span>
                      <span class="uuas-text-sm"><%= c.lecturer_name %></span>
                    </div>
                  </td>
                  <td class="uuas-text-sm uuas-muted"><%= c.department || '—' %></td>
                  <td>
                    <span class="uuas-bold" style="color:var(--uuas-gray-800)"><%= c.enrolled_count %> students</span>
                  </td>
                  <td class="uuas-text-right">
                    <a href="/admin/courses/<%= c.id %>/enroll" class="uuas-btn uuas-btn--primary uuas-btn--sm">Manage Enrollment</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="uuas-pagination-row">
          <span>Showing <%= courses.length %> course modules</span>
          <div class="uuas-pagination-controls">
            <button class="uuas-page-btn">‹</button>
            <button class="uuas-page-btn uuas-page-active">1</button>
            <button class="uuas-page-btn">›</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
