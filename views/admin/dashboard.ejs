<%- include('../partials/head', { title: title }) %>
<div class="uuas-app">
  <%- include('../partials/sidebar-admin') %>
  <div class="uuas-main">
    <%- include('../partials/navbar', { topbarTitle: 'Admin Console' }) %>
    <div class="uuas-content">
      <div class="uuas-page-header uuas-flex-between uuas-mb-6">
        <div>
          <h1 class="uuas-h2">System Overview</h1>
          <p class="uuas-text-sm uuas-muted" style="margin-top:0.25rem">University of Uyo — Attendance Management & Administrative Operations</p>
        </div>
        <span class="uuas-pill uuas-pill--ontime" style="display:inline-flex;align-items:center;gap:6px">
          <span class="uuas-live-dot"></span> System Online
        </span>
      </div>

      <!-- TeamHub Top Grid: 3 Summary Cards + System Activity Trend Chart -->
      <div class="uuas-overview-grid">
        <!-- Card 1: Mint (Active Students) -->
        <div class="uuas-summary-card--mint">
          <div class="uuas-summary-title">Active Students</div>
          <div class="uuas-summary-val-row">
            <div class="uuas-summary-value"><%= stats.totalStudents %></div>
            <div class="uuas-summary-delta">Registered</div>
          </div>
          <div class="uuas-summary-footer">
            <span>University enrollment</span>
          </div>
        </div>

        <!-- Card 2: Vibrant Green (Lecturers & Courses) -->
        <div class="uuas-summary-card--green">
          <div class="uuas-summary-title">Faculty & Courses</div>
          <div class="uuas-summary-val-row">
            <div class="uuas-summary-value"><%= stats.totalCourses %></div>
            <div class="uuas-summary-delta"><%= stats.totalLecturers %> Lecturers</div>
          </div>
          <div class="uuas-summary-footer">
            <span>Active academic units</span>
          </div>
        </div>

        <!-- Card 3: Dark Forest Green (Live Sessions & Marks) -->
        <div class="uuas-summary-card--dark">
          <div class="uuas-summary-title">Live & Total Marks</div>
          <div class="uuas-summary-val-row">
            <div class="uuas-summary-value"><%= stats.totalMarked %></div>
            <div class="uuas-summary-delta"><%= stats.activeSessions %> Live Now</div>
          </div>
          <div class="uuas-summary-footer">
            <span>Total verifications recorded</span>
          </div>
        </div>

        <!-- Card 4: Attendance Overview Trend Bar Chart -->
        <div class="uuas-chart-card">
          <div class="uuas-chart-header">
            <div class="uuas-chart-title">System Activity Overview</div>
            <select class="uuas-chart-select" aria-label="Time period">
              <option>Last 6 Months</option>
              <option>This Session</option>
            </select>
          </div>
          <div class="uuas-chart-body">
            <div class="uuas-chart-y-axis">
              <span>100%</span>
              <span>75%</span>
              <span>50%</span>
              <span>25%</span>
              <span>0%</span>
            </div>
            <div class="uuas-chart-bars">
              <% ['Feb','Mar','Apr','May','Jun','Jul'].forEach((m, idx) => { 
                  const pHeight = 55 + (idx * 6) % 30;
              %>
                <div class="uuas-chart-col">
                  <div class="uuas-chart-bar-stack">
                    <div class="uuas-bar-seg--present" style="height:<%= Math.round(pHeight * 0.75) %>%"></div>
                    <div class="uuas-bar-seg--leave" style="height:<%= Math.round(pHeight * 0.15) %>%"></div>
                    <div class="uuas-bar-seg--absent" style="height:<%= Math.max(5, 100 - pHeight) %>%"></div>
                  </div>
                  <span class="uuas-chart-col-label"><%= m %></span>
                </div>
              <% }) %>
            </div>
          </div>
          <div class="uuas-chart-legend">
            <div class="uuas-legend-item"><span class="uuas-legend-dot" style="background:#34d399"></span> Present</div>
            <div class="uuas-legend-item"><span class="uuas-legend-dot" style="background:var(--uuas-green)"></span> Verified</div>
            <div class="uuas-legend-item"><span class="uuas-legend-dot" style="background:var(--uuas-green-forest)"></span> Absent</div>
          </div>
        </div>
      </div>

      <!-- Quick Actions (TeamHub Style Cards) -->
      <h2 class="uuas-h3" style="margin-bottom:1rem">Administrative Shortcuts</h2>
      <div class="uuas-grid-3" style="margin-bottom:2rem">
        <a href="/admin/users/new" class="uuas-card" style="text-decoration:none;transition:box-shadow var(--uuas-dur);display:block" onmouseover="this.style.boxShadow='var(--uuas-shadow-md)'" onmouseout="this.style.boxShadow=''">
          <div class="uuas-card-body uuas-text-center" style="padding:1.75rem 1.25rem">
            <div style="width:48px;height:48px;background:#ecfdf5;border-radius:var(--uuas-r-full);color:#065f46;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            </div>
            <div class="uuas-bold" style="font-size:1rem;color:var(--uuas-gray-900)">Add New User</div>
            <div class="uuas-text-xs uuas-muted" style="margin-top:0.25rem">Create student, lecturer, or admin accounts</div>
          </div>
        </a>
        <a href="/admin/courses" class="uuas-card" style="text-decoration:none;display:block" onmouseover="this.style.boxShadow='var(--uuas-shadow-md)'" onmouseout="this.style.boxShadow=''">
          <div class="uuas-card-body uuas-text-center" style="padding:1.75rem 1.25rem">
            <div style="width:48px;height:48px;background:#eff6ff;border-radius:var(--uuas-r-full);color:#1e40af;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div class="uuas-bold" style="font-size:1rem;color:var(--uuas-gray-900)">Manage Courses</div>
            <div class="uuas-text-xs uuas-muted" style="margin-top:0.25rem">Assign faculty and enroll student rosters</div>
          </div>
        </a>
        <a href="/admin/reports" class="uuas-card" style="text-decoration:none;display:block" onmouseover="this.style.boxShadow='var(--uuas-shadow-md)'" onmouseout="this.style.boxShadow=''">
          <div class="uuas-card-body uuas-text-center" style="padding:1.75rem 1.25rem">
            <div style="width:48px;height:48px;background:#fef3c7;border-radius:var(--uuas-r-full);color:#92400e;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <div class="uuas-bold" style="font-size:1rem;color:var(--uuas-gray-900)">System Analytics</div>
            <div class="uuas-text-xs uuas-muted" style="margin-top:0.25rem">Audit logs and at-risk student monitoring</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
