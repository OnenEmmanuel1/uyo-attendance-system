<%- include('../partials/head', { title: 'Sign In — AttendUyo' }) %>

<div class="uuas-login-wrap">
  <div class="uuas-login-split">

    <!-- Brand Panel (Desktop only: Deep Forest Green with Official Logo & Feature Bullets) -->
    <div class="uuas-login-brand">
      <div>
        <div class="uuas-login-brand-logo">
          <img src="/images/logo.png" alt="AttendUyo Logo" class="uuas-login-logo-img">
          <div>
            <h1 class="uuas-h2" style="color:#ffffff;line-height:1">AttendUyo</h1>
            <span style="font-size:0.75rem;color:#a7f3d0;font-weight:500">University of Uyo</span>
          </div>
        </div>

        <p style="color:#d1fae5;font-size:0.9375rem;line-height:1.6;margin-top:1.5rem">
          Next-generation biometric & geofenced attendance management system for students, faculty, and academic
          administrators.
        </p>

        <div style="margin-top:2.5rem;display:flex;flex-direction:column;gap:1.25rem">
          <div class="uuas-login-brand-feature">
            <div class="uuas-login-brand-feature-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"
                aria-hidden="true">
                <polyline points="9 11 12 14 22 4" />
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
              </svg>
            </div>
            Dynamic QR & GPS geofenced verification
          </div>
          <div class="uuas-login-brand-feature">
            <div class="uuas-login-brand-feature-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"
                aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            Hardware-grade WebAuthn biometric security
          </div>
          <div class="uuas-login-brand-feature">
            <div class="uuas-login-brand-feature-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"
                aria-hidden="true">
                <line x1="18" y1="20" x2="18" y2="10" />
                <line x1="12" y1="20" x2="12" y2="4" />
                <line x1="6" y1="20" x2="6" y2="14" />
              </svg>
            </div>
            Real-time session monitoring & audit trail
          </div>
        </div>
      </div>

      <div style="font-size:0.75rem;color:#a7f3d0;padding-top:2rem">
        &copy; <%= typeof year !=='undefined' ? year : new Date().getFullYear() %> University of Uyo. All rights
          reserved.
      </div>
    </div>

    <!-- Login Form Column -->
    <div class="uuas-login-form-col">
      <div class="uuas-login-form-box">

        <!-- Mobile-Only Logo Header -->
        <div class="uuas-login-mobile-logo">
          <img src="/images/logo.png" alt="AttendUyo Logo" class="uuas-login-logo-img">
          <div>
            <h1 class="uuas-h3" style="margin:0;line-height:1.1;color:var(--uuas-green-forest)">AttendUyo</h1>
            <span style="font-size:0.75rem;color:var(--uuas-text-muted);font-weight:500">University of Uyo</span>
          </div>
        </div>

        <div style="margin-bottom:1.75rem">
          <h2 class="uuas-h2" style="margin-bottom:0.25rem">Welcome Back</h2>
          <p class="uuas-text-sm uuas-muted">Sign in with your university credentials to continue</p>
        </div>

        <% if (typeof error !=='undefined' && error) { %>
          <div class="uuas-alert uuas-alert--error" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div><%= error %></div>
          </div>
        <% } %>

        <form method="POST" action="/login" novalidate id="uuas-login-form">
          <div class="uuas-form-group">
            <label class="uuas-label" for="email">Institutional Email</label>
            <input
              type="email"
              id="email"
              name="email"
              class="uuas-input"
              placeholder="user@uniuyo.edu.ng"
              autocomplete="email"
              required
              aria-required="true"
            >
          </div>

          <div class="uuas-form-group">
            <label class="uuas-label" for="password">Password</label>
            <div style="position:relative">
              <input
                type="password"
                id="password"
                name="password"
                class="uuas-input"
                placeholder="Enter account password"
                autocomplete="current-password"
                required
                aria-required="true"
                style="padding-right:2.75rem"
              >
              <button
                type="button"
                id="uuas-toggle-pw"
                style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;color:var(--uuas-gray-400);padding:4px;display:flex;align-items:center;justify-content:center"
                aria-label="Toggle password visibility"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  aria-hidden="true" id="pw-icon">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="uuas-btn uuas-btn--primary uuas-btn--lg"
            style="width:100%;margin-top:0.5rem" id="uuas-login-btn">
            Sign In
          </button>
        </form>

        <hr class="uuas-divider">
        <div style="background:var(--uuas-gray-50);border:1px solid var(--uuas-border-strong);border-radius:var(--uuas-r-md);padding:0.85rem 1rem;font-size:0.75rem;color:var(--uuas-gray-700)">
          <strong style="display:block;margin-bottom:0.45rem;color:var(--uuas-gray-900)">Demo Accounts (Password: <code>password123</code>)</strong>
          <div style="display:flex;flex-direction:column;gap:0.35rem">
            <span style="display:flex;align-items:center;gap:0.4rem"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> <strong>Admin:</strong> <code>admin@uniuyo.edu.ng</code> / <code>password123</code></span>
            <span style="display:flex;align-items:center;gap:0.4rem"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg> <strong>Lecturer:</strong> <code>b.okon@uniuyo.edu.ng</code> / <code>password123</code></span>
            <span style="display:flex;align-items:center;gap:0.4rem"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> <strong>Student:</strong> <code>a.umoh@students.uniuyo.edu.ng</code> / <code>password123</code></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Password visibility toggle
  const pwInput = document.getElementById('password');
  const toggleBtn = document.getElementById('uuas-toggle-pw');
  if (toggleBtn && pwInput) {
    toggleBtn.addEventListener('click', () => {
      pwInput.type = pwInput.type === 'password' ? 'text' : 'password';
    });
  }

  // Loading state on submit
  const loginForm = document.getElementById('uuas-login-form');
  if (loginForm) {
    loginForm.addEventListener('submit', () => {
      const btn = document.getElementById('uuas-login-btn');
      if (btn) {
        btn.textContent = 'Authenticating…';
        btn.disabled = true;
      }
    });
  }
</script>

<%- include('../partials/footer') %>