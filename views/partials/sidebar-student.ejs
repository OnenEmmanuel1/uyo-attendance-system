<nav class="uuas-sidebar" id="uuas-sidebar" aria-label="Student navigation">
  <a href="/student/dashboard" class="uuas-sidebar-logo" aria-label="AttendUyo Home">
    <img src="/images/logo.png" alt="AttendUyo Logo" class="uuas-sidebar-logo-img">
    <div>
      <div class="uuas-sidebar-logo-text">AttendUyo</div>
      <div class="uuas-sidebar-logo-sub">Student Portal</div>
    </div>
  </a>

  <div class="uuas-sidebar-section">
    <div class="uuas-sidebar-section-label">Menu</div>
    <a href="/student/dashboard" class="uuas-nav-item" id="nav-dashboard">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>
    <a href="/student/mark-attendance" class="uuas-nav-item" id="nav-mark">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      Mark Attendance
    </a>
    <a href="/student/courses" class="uuas-nav-item" id="nav-courses">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      My Courses
    </a>
    <a href="/student/history" class="uuas-nav-item" id="nav-history">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      History
    </a>
    <a href="/profile" class="uuas-nav-item" id="nav-profile">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      My Profile
    </a>
  </div>

  <div class="uuas-sidebar-footer">
    <a href="/profile" class="uuas-sidebar-user" style="text-decoration:none" title="View Profile">
      <div class="uuas-sidebar-avatar">
        <% if (typeof user !== 'undefined' && user && user.avatar_url) { %>
          <img src="<%= user.avatar_url %>" alt="<%= user.name %>" class="uuas-avatar-img">
        <% } else if (typeof student !== 'undefined' && student && student.name) { %>
          <%= student.name.charAt(0).toUpperCase() %>
        <% } else if (typeof user !== 'undefined' && user && user.name) { %>
          <%= user.name.charAt(0).toUpperCase() %>
        <% } else { %>
          S
        <% } %>
      </div>
      <div style="min-width:0;flex:1">
        <div class="uuas-sidebar-user-name uuas-truncate"><%= typeof student !== 'undefined' && student ? student.name : (typeof user !== 'undefined' && user ? user.name : 'Student') %></div>
        <div class="uuas-sidebar-user-role">Student</div>
      </div>
    </a>
    <a href="/logout" class="uuas-nav-item">
      <svg class="uuas-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Sign Out
    </a>
  </div>
</nav>
