<header class="uuas-topbar" role="banner">
  <div class="uuas-flex uuas-items-center uuas-gap-3">
    <button class="uuas-icon-btn" id="uuas-sidebar-toggle" aria-label="Toggle navigation" style="display:none">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="uuas-topbar-left">
      <div class="uuas-topbar-breadcrumb">
        <span>AttendUyo</span>
      </div>
      <h1 class="uuas-topbar-title"><%= typeof topbarTitle !== 'undefined' ? topbarTitle : (typeof title !== 'undefined' ? title.split(' — ')[0] : 'Attendance') %></h1>
    </div>
  </div>

  <div class="uuas-topbar-right">
    <div class="uuas-topbar-search">
      <svg class="uuas-topbar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" class="uuas-topbar-search-input" placeholder="Search anything..." aria-label="Search">
    </div>

    <!-- Settings Link -->
    <a href="/profile" class="uuas-icon-btn" aria-label="Profile Settings" title="Profile Settings">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </a>

    <!-- Interactive Notifications Dropdown -->
    <div class="uuas-notif-wrap" id="uuas-notif-container">
      <button class="uuas-icon-btn" id="uuas-notif-btn" aria-label="Notifications" title="Notifications" aria-expanded="false" aria-haspopup="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span class="uuas-notif-badge-count" id="uuas-notif-badge" style="display:none">0</span>
      </button>

      <div class="uuas-notif-dropdown" id="uuas-notif-menu" role="menu" aria-label="Notifications list">
        <div class="uuas-notif-header">
          <div class="uuas-notif-title">
            <span>Notifications</span>
            <span class="uuas-pill uuas-pill--ontime" id="uuas-notif-count-pill" style="font-size:0.6875rem;padding:0.15rem 0.45rem">0 New</span>
          </div>
          <button type="button" class="uuas-notif-mark-btn" id="uuas-notif-mark-read">Mark all as read</button>
        </div>

        <div class="uuas-notif-list" id="uuas-notif-list">
          <div class="uuas-notif-empty">Loading notifications…</div>
        </div>

        <div class="uuas-notif-footer">
          <a href="<%= typeof user !== 'undefined' && user ? '/' + user.role + '/dashboard' : '#' %>">View Activity Overview</a>
        </div>
      </div>
    </div>

    <!-- User Profile Link -->
    <%
      const displayName = typeof user !== 'undefined' && user ? user.name : (typeof student !== 'undefined' && student ? student.name : 'User');
      const nameParts = displayName.trim().split(/\s+/);
      let firstName = nameParts[0];
      if (/^(Prof\.|Dr\.|Mr\.|Mrs\.|Ms\.|Engr\.|Assoc\.)/i.test(nameParts[0]) && nameParts.length > 1) {
        firstName = nameParts[1];
      }
    %>
    <a href="/profile" class="uuas-topbar-user" title="My Profile" style="text-decoration:none">
      <div class="uuas-topbar-user-avatar">
        <% if (typeof user !== 'undefined' && user && user.avatar_url) { %>
          <img src="<%= user.avatar_url %>" alt="<%= user.name %>" class="uuas-avatar-img">
        <% } else if (typeof user !== 'undefined' && user && user.name) { %>
          <%= user.name.charAt(0).toUpperCase() %>
        <% } else if (typeof student !== 'undefined' && student && student.name) { %>
          <%= student.name.charAt(0).toUpperCase() %>
        <% } else { %>
          U
        <% } %>
      </div>
      <div class="uuas-topbar-user-meta">
        <span class="uuas-topbar-user-name uuas-desktop-name"><%= displayName %></span>
        <span class="uuas-topbar-user-name uuas-mobile-name"><%= firstName %></span>
        <span class="uuas-topbar-user-role"><%= typeof user !== 'undefined' && user ? (user.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'Staff') : (typeof student !== 'undefined' && student ? 'Student' : 'User') %></span>
      </div>
    </a>

    <span class="uuas-text-sm uuas-muted" style="display:none" id="uuas-topbar-time"></span>
    <a href="/logout" class="uuas-btn uuas-btn--ghost uuas-btn--sm uuas-topbar-logout" id="uuas-topbar-logout" title="Sign Out" style="margin-left:0.25rem">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </a>
  </div>
</header>

<script>
  (function() {
    // Topbar mobile toggle & time display
    if (window.innerWidth <= 768) {
      const toggle = document.getElementById('uuas-sidebar-toggle');
      if (toggle) toggle.style.display = 'flex';
      const tEl = document.getElementById('uuas-topbar-time');
      if (tEl) tEl.style.display = '';
    }
    function updateTime() {
      const el = document.getElementById('uuas-topbar-time');
      if (el) el.textContent = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
    }
    updateTime();
    setInterval(updateTime, 60000);

    // ── Notifications System ──────────────────────────────────
    const notifBtn      = document.getElementById('uuas-notif-btn');
    const notifMenu     = document.getElementById('uuas-notif-menu');
    const notifBadge    = document.getElementById('uuas-notif-badge');
    const countPill     = document.getElementById('uuas-notif-count-pill');
    const notifList     = document.getElementById('uuas-notif-list');
    const markReadBtn   = document.getElementById('uuas-notif-mark-read');
    const notifContainer= document.getElementById('uuas-notif-container');

    function formatTimeAgo(dateStr) {
      const now  = new Date();
      const past = new Date(dateStr);
      const diff = Math.floor((now - past) / 1000);
      if (diff < 60) return 'Just now';
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      return past.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    }

    function getIconSvg(type) {
      if (type === 'session_active') {
        return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>';
      } else if (type === 'attendance_success') {
        return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
      } else if (type === 'new_user') {
        return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>';
      }
      return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>';
    }

    async function loadNotifications() {
      try {
        const res = await fetch('/api/notifications');
        if (!res.ok) return;
        const data = await res.json();
        const { unreadCount, notifications } = data;

        if (unreadCount > 0) {
          notifBadge.textContent = unreadCount > 9 ? '9+' : unreadCount;
          notifBadge.style.display = 'flex';
          countPill.textContent = `${unreadCount} New`;
        } else {
          notifBadge.style.display = 'none';
          countPill.textContent = 'All caught up';
        }

        if (!notifications || notifications.length === 0) {
          notifList.innerHTML = '<div class="uuas-notif-empty">No notifications yet.</div>';
          return;
        }

        let html = '';
        notifications.forEach(n => {
          html += `
            <a href="${n.link || '#'}" class="uuas-notif-item ${n.isUnread ? 'uuas-unread' : ''}">
              <div class="uuas-notif-item-icon">
                ${getIconSvg(n.type)}
              </div>
              <div class="uuas-notif-item-body">
                <div class="uuas-notif-item-title">${n.title}</div>
                <div class="uuas-notif-item-msg">${n.message}</div>
                <div class="uuas-notif-item-time">${formatTimeAgo(n.createdAt)}</div>
              </div>
              ${n.isUnread ? '<span class="uuas-notif-dot"></span>' : ''}
            </a>
          `;
        });
        notifList.innerHTML = html;
      } catch (err) {
        notifList.innerHTML = '<div class="uuas-notif-empty">Unable to load notifications.</div>';
      }
    }

    // Toggle dropdown on button click
    if (notifBtn && notifMenu) {
      notifBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = notifMenu.classList.toggle('uuas-open');
        notifBtn.setAttribute('aria-expanded', isOpen);
        if (isOpen) loadNotifications();
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (notifContainer && !notifContainer.contains(e.target)) {
          notifMenu.classList.remove('uuas-open');
          notifBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Mark all as read
    if (markReadBtn) {
      markReadBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await fetch('/api/notifications/mark-read', { method: 'POST' });
          notifBadge.style.display = 'none';
          countPill.textContent = 'All caught up';
          document.querySelectorAll('.uuas-notif-item.uuas-unread').forEach(el => el.classList.remove('uuas-unread'));
          document.querySelectorAll('.uuas-notif-dot').forEach(el => el.remove());
        } catch (_) {}
      });
    }

    // Initial load
    loadNotifications();
  })();
</script>
