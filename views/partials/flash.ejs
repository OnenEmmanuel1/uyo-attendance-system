<% if (typeof flashError !== 'undefined' && flashError && flashError.length) { %>
  <% flashError.forEach(msg => { %>
    <div class="uuas-alert uuas-alert--error" data-autodismiss="true" role="alert">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div><%= msg %></div>
    </div>
  <% }) %>
<% } %>
<% if (typeof flashSuccess !== 'undefined' && flashSuccess && flashSuccess.length) { %>
  <% flashSuccess.forEach(msg => { %>
    <div class="uuas-alert uuas-alert--success" data-autodismiss="true" role="alert">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <div><%= msg %></div>
    </div>
  <% }) %>
<% } %>
